rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users collection
    // Game fields (points, victoires, matchsJoues, countryCode, isAdmin)
    // are admin-only : un membre ne peut modifier que son propre profil cosmétique.
    match /users/{userId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.isAdmin == false
        && request.resource.data.points == 0
        && request.resource.data.victoires == 0
        && request.resource.data.matchsJoues == 0
        && request.resource.data.countryCode == '';
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['prenom', 'nom', 'photoUrl', 'photoDriveId']));
    }

    // Matches collection — admin write, authenticated read
    match /matches/{matchId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
